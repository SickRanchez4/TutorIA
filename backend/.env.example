# Flask Environment
FLASK_ENV=development

# JWT Configuration (REQUIRED - must be set or app will not start)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here-change-me-generate-with-command-above

# PostgreSQL 18.x externo. No usar DATABASE_URL ni codificar la contraseña como URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutoria-webapp
DB_USER=tutoria
DB_PASSWORD='reemplazar-con-la-contrasena-de-postgresql'
DB_SSLMODE=prefer

# Request body cap (default: 64 MiB) and shared limiter storage for production
MAX_CONTENT_LENGTH=67108864
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Number of trusted reverse proxies in front of Flask (0 when running directly)
TRUSTED_PROXY_COUNT=0
# Keep disabled unless the deployment intentionally supports self-registration.
ALLOW_PUBLIC_REGISTRATION=false

# n8n / External Webhook URLs (optional - can also be set per institution in DB)
# Webhook para procesar carpetas de PDFs y generar embeddings
N8N_EMBEDDINGS_WEBHOOK_URL=http://localhost:5678/webhook/upload-knowledge

# Student chat and knowledge administration webhooks
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/course-chat
N8N_KNOWLEDGE_ADMIN_WEBHOOK_URL=http://localhost:5678/webhook/knowledge-admin
# Same value as the n8n "TutorIA Backend" Header Auth credential (X-TutorIA-Token).
N8N_KNOWLEDGE_ADMIN_TOKEN=

# Webhook para procesar Excel de cursos (si se desea integración con n8n)
N8N_EXCEL_CURSOS_WEBHOOK_URL=http://localhost:5678/webhook/import-cursos

# Webhook para procesar Excel de alumnos y matrículas (si se desea integración con n8n)
N8N_EXCEL_ALUMNOS_WEBHOOK_URL=http://localhost:5678/webhook/import-alumnos
