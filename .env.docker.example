# Copiar a .env.docker. No subir el archivo real al repositorio.

# Aplicación con Docker Compose.
# En Cloud Server deja este valor para que el frontend solo escuche localmente.
APP_PORT=127.0.0.1:8080
FRONTEND_URL=https://app.tudominio.com
LOG_LEVEL=INFO
JWT_SECRET_KEY=reemplaza-este-valor-por-un-secreto-largo-y-aleatorio

# Solo para docker-compose.production.yml: dominio público sin http(s).
DOMAIN=app.tudominio.com

# SQL Server: usar el nombre de driver instalado en el contenedor.
DATABASE_URL=mssql+pyodbc://USUARIO:CONTRASENA@HOST:1433/BASE_DE_DATOS?driver=ODBC+Driver+17+for+SQL+Server

# Integraciones n8n. El chat usa la URL de producción, no /webhook-test/.
N8N_EMBEDDINGS_WEBHOOK_URL=https://tu-n8n.example/webhook/upload-knowledge
N8N_KNOWLEDGE_ADMIN_WEBHOOK_URL=https://tu-n8n.example/webhook/knowledge-admin
N8N_CHAT_WEBHOOK_URL=https://tu-n8n.example/webhook/course-chat
N8N_EXCEL_CURSOS_WEBHOOK_URL=https://tu-n8n.example/webhook/import-cursos
N8N_EXCEL_ALUMNOS_WEBHOOK_URL=https://tu-n8n.example/webhook/import-alumnos

